# Base URL of the Hangyul backend API.
#
# Leave EMPTY for local development — the Vite dev server proxies "/api" to the
# backend (see vite.config.ts), so there are no CORS issues.
#
# For a production build, set this to the full backend origin, e.g.
#   VITE_API_BASE_URL=https://api.hangyul.app
VITE_API_BASE_URL=

# Only used by the Vite dev proxy (npm run dev). Where the backend runs locally.
VITE_DEV_BACKEND=http://127.0.0.1:8000
