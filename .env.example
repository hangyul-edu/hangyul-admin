# Base URL of the Hangyul backend API.
#
# Leave EMPTY for local development — the Vite dev server proxies "/api" to the
# backend (see vite.config.ts), so there are no CORS issues.
#
# Deployed builds (Vercel) must set the API's https origin, no /api suffix, e.g.
#   VITE_API_BASE_URL=https://api.talkhangyul.com
# A Vercel build without it fails on purpose.
VITE_API_BASE_URL=

# Only used by the Vite dev proxy (npm run dev). Where the backend runs locally.
VITE_DEV_BACKEND=http://127.0.0.1:8000

# Optional: the member app's address (its own domain). The access-denied screen
# links to it; empty → no link.
#   VITE_MEMBER_APP_URL=https://talkhangyul.com
VITE_MEMBER_APP_URL=
